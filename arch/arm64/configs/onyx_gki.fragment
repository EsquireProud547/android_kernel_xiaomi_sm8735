#
# onyx_gki.fragment - Capybara tuning layered onto the stock Android GKI base
#
# Tree: seventeen @ 6.6.142 (Xiaomi SM8735 / onyx). Migrated from the
# kernel_xiaomi_sm8735 tree, which is android15-6.6 @ 6.6.82. Every symbol
# below was re-verified to exist in this tree's Kconfig on 6.6.142.
#
# Synthesis order mirrors the official Kleaf mixed-build (build.config.msm.perf
# + build.config.msm.common):
#
#   gki_defconfig                 (stock GKI 6.6.142 base, 796 lines)
#     + onyx_gki.fragment         (this file: Capybara tuning)
#     + vendor/onyx_perf.config   (=y entries only, filtered at build time)
#     + onyx_susfs.fragment       (only when enable_susfs is true)
#   -> merge_config.sh -m -r -y  -> make <defconfig>
#
# RULES for editing this file (they are enforced by the three gates that
# build-onyx.yml replicates from build.config.msm.common):
#
#   1. Never set a symbol the base already has as =y or =m. merge_config
#      reports it as an override and the build fails ("Detected overridden
#      config!").
#   2. Never set a symbol whose dependencies will not be met. olddefconfig
#      drops it silently, the diffconfig gate then fails the build
#      ("Defconfig fragment did not apply as expected").
#
# In short: every line here is a promise that the kernel will honour.
#
# Verified against this tree's gki_defconfig by line number:
#   98  CONFIG_CFI_CLANG=y     -> rules out FullLTO
#   745 CONFIG_CRYPTO_LZ4=y    -> ZRAM_DEF_COMP_LZ4 dependency is satisfied
#   (no CONFIG_HZ_* line)      -> HZ_300 cannot collide with an explicit value
#   (no CONFIG_LTO_* line)     -> LTO_NONE is a Kconfig default, not a defconfig
#                                 value, so merge_config does not see an override
#
# Link Time Optimization is NOT set here. It is generated at build time into
# onyx_lto.fragment, under the `enable_thinlto` input, for the same reason
# AutoFDO is: it has to be switchable, and a static fragment cannot be
# switched off without also losing everything else in this file. The stock
# device kernel uses LTO_NONE, so with enable_thinlto=false this build
# matches it exactly.
#

# --- Timer frequency -------------------------------------------------------
# GKI default is HZ_250; the stock GKI fragment (which lives in the external
# build/kernel repo and is NOT in this tree) is what normally picks the value.
CONFIG_HZ_300=y

# --- zram compression ------------------------------------------------------
# GKI default is lzo-rle. lz4 is materially faster to decompress, which is
# what matters on the zram hot path under memory pressure.
# CONFIG_CRYPTO_LZ4 is already =y in the GKI base (gki_defconfig:745), so the
# dependency holds.
#
# 6.6.142 also turns on ZRAM_MULTI_COMP and ZRAM_WRITEBACK in the base. Both
# are additive: ZRAM_DEF_COMP_LZ4 still selects the default algorithm used when
# no explicit zram.recompress_algorithm is set at boot, so this line still does
# what it says.
CONFIG_ZRAM_DEF_COMP_LZ4=y

# --- Droidspaces (POSIX IPC for the container runtime) ---------------------
# SOURCE: ravindu644/Droidspaces-OSS Documentation/Kernel-Configuration.md,
# the "配置 GKI 内核" block, at commit 92cee27 (2026-10-05). That block is the
# authoritative list: upstream states these specific options are kABI-safe only
# in combination with the Step 1 sysvipc patch, and warns against enabling
# anything beyond it. The same list is embedded in the app under Settings ->
# Requirements, so copy-pasting it into the app is a valid cross-check.
#
# Upstream splits the list into a required part and an optional-but-recommended
# part; both are below. The one upstream line that is NOT reproduced is
# CONFIG_NETFILTER_XT_TARGET_REJECT, and it is explained at the bottom.
#
# CONFIG_SYSVIPC requires .github/actions/droidspaces_sysvipc.patch: the plain
# upstream config injects sysvsem/sysvshm into the middle of task_struct and
# shifts every following field, which breaks vendor modules. The patch moves
# them onto the ANDROID_KABI_RESERVE(6/7/8) padding instead.
# CONFIG_ANDROID_KABI_RESERVE defaults to y (drivers/android/Kconfig), so the
# union overlay keeps task_struct size and all trailing offsets unchanged.
#
# This tree also has CONFIG_GKI_DYNAMIC_TASK_STRUCT_SIZE=y with
# GKI_TASK_STRUCT_VENDOR_SIZE_MAX=1024. That is a *separate* mechanism and does
# not conflict: it allocates the vendor area after sizeof(struct task_struct)
# (include/linux/sched/task.h, `android_task_vendor_data()` returns `p + 1`), so
# it cannot shift anything inside the struct. ANDROID_KABI_RESERVE still
# operates on slots inside task_struct.
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y

# --- Namespaces and container compatibility --------------------------------
# PID_NS + devtmpfs are what a container runtime expects to exist.
CONFIG_PID_NS=y
CONFIG_DEVTMPFS=y

# --- Optional but recommended: docker/proot compat + NixOS tmpfs ACLs ------
CONFIG_USER_NS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- Droidspaces: NAT66 ----------------------------------------------------
# Without these, a container in NAT mode is IPv4-only. Both symbols come from
# the upstream GKI block in Droidspaces' Documentation/Kernel-Configuration.md
# (2026-10-04 revision).
#
# IP6_NF_NAT depends on NF_CONNTRACK and NETFILTER_ADVANCED; both are =y in
# the base. It selects NF_NAT, so no extra line is needed for NAT66.
# IP6_NF_TARGET_MASQUERADE selects NETFILTER_XT_TARGET_MASQUERADE.
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- Droidspaces: UFW support inside the container -------------------------
# Optional: only needed to run UFW or fail2ban inside a container, and only in
# NAT mode so the container does not fight the host's own firewall.
#
# XT_TARGET_LOG selects NF_LOG_SYSLOG. XT_MATCH_RECENT depends on
# NETFILTER_ADVANCED, which the base already satisfies.
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# --- Droidspaces: fail2ban support (ipset) ---------------------------------
# IP_SET is a menuconfig depending on INET && NETFILTER, both =y here. The two
# hash types are the ones fail2ban uses, and XT_SET depends on IP_SET plus
# NETFILTER_ADVANCED, so the order below is also the dependency order.
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# --- tmpfs extended attributes ---------------------------------------------
# NixOS support. TMPFS_XATTR enables trusted.*, security.* and user.* xattr
# namespaces on tmpfs; it is what POSIX ACL support on tmpfs needs, so it pairs
# with CONFIG_TMPFS_POSIX_ACL above. Depends on TMPFS, =y in the base.
CONFIG_TMPFS_XATTR=y

# --- Deliberately NOT enabled: CONFIG_CFS_BANDWIDTH and CONFIG_CGROUP_PIDS --
# These power `--cpus` and `--pids-limit`. Droidspaces' own guide keeps them
# commented out of the GKI block and explains why: they resize the scheduler
# and cgroup structures, so the CRC of thousands of exported symbols changes
# (4101 of them, measured upstream on a 5.15 GKI tree). Stock vendor modules
# were built against the old CRCs, they refuse to load, and without display,
# storage and Wi-Fi the device bootloops.
#
# Unlike CONFIG_SYSVIPC, the new fields do not fit the ANDROID_KABI_RESERVE
# padding, so droidspaces_sysvipc.patch cannot help here. They can only be
# turned on if EVERY module is rebuilt from this same tree and vendor_boot,
# vendor_dlkm and system_dlkm are flashed together with the new boot.img.
# Left off. CONFIG_MEMCG is already =y in the GKI base, so --memory works.

# NOTE: upstream's GKI block also lists CONFIG_NETFILTER_XT_TARGET_REJECT. That
# symbol no longer exists in 6.6; the REJECT target moved to
# CONFIG_IP_NF_TARGET_REJECT / CONFIG_IP6_NF_TARGET_REJECT (iptables/nftables
# in 6.6 build xt_REJECT from net/ipv4/netfilter/ipt_REJECT.c), and both are
# already =y in gki_defconfig. Writing the old name would be dropped by
# olddefconfig and would then fail the diffconfig gate.
#
# Likewise CONFIG_CGROUP_DEVICE appears in upstream's non-GKI block but not in
# its GKI block, and upstream's "what breaks if missing" table calls it fatal.
# It has no Kconfig dependencies in 6.6 and is not in the frozen kABI list, so
# it could be turned on, but stock onyx does not have it either and upstream
# deliberately omits it from the kABI-tested set. Not added. Say so here rather
# than leaving the gap unexplained.
